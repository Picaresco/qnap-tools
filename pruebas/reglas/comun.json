  {"cmd": "date", "max_posicionales": 0, "solo_flags": ["-u", "-R"], "nota": "hora actual"},
  {"cmd": "hostname", "max_posicionales": 0, "solo_flags": ["-f", "-s", "-i", "-d"], "nota": "sin argumento no cambia el nombre"},
  {"cmd": "echo", "nota": "texto"},
  {"cmd": "printf", "nota": "texto"},
  {"cmd": "test", "nota": "comprobacion"},
  {"cmd": "[", "nota": "comprobacion"},
  {"cmd": "true", "nota": "nada"},
  {"cmd": "read", "solo_flags": ["-r"], "max_posicionales": 1, "nota": "orden interna del shell: deja una linea de la entrada en una variable; no toca ficheros"},
  {"cmd": "which", "nota": "solo lee"},
  {"cmd": "type", "nota": "solo lee"},
  {"cmd": "ps", "nota": "solo lee"},
  {"cmd": "free", "nota": "solo lee"},
  {"cmd": "lsmod", "nota": "solo lee"},
