  {"cmd": "lsusb", "nota": "solo lee"},
  {"cmd": "lsblk", "nota": "solo lee"},
  {"cmd": "dmesg", "solo_flags": [], "max_posicionales": 0, "nota": "sin -c, que vacia el buffer"},
  {"cmd": "mount", "solo_flags": [], "max_posicionales": 0, "nota": "sin argumentos solo lista"},
  {"cmd": "find", "deny": ["^-(delete|exec|execdir|ok|okdir|fprint.*|fls)$"], "nota": "sin acciones"},
  {"cmd": "awk", "deny": ["system\\s*\\(", "getline", "\\|\\s*\"", "\"\\s*\\|", "print[^;}]*>", "close\\s*\\("], "nota": "sin ejecutar comandos ni escribir ficheros"},
  {"cmd": "seq", "nota": "texto"},
  {"cmd": "sleep", "nota": "espera"},
  {"cmd": "getcfg", "nota": "lee un campo de un .conf; la escritura es setcfg"},
  {"cmd": "zpool", "sub": ["list", "status", "get", "history", "iostat"], "nota": "subcomandos de consulta"},
  {"cmd": "zfs", "sub": ["list", "get"], "nota": "subcomandos de consulta"},
  {"cmd": "qcli_storage", "solo_flags": ["-d", "-p", "-v"], "max_posicionales": 0, "nota": "ayuda del comando: -d discos, -p reparto, -v rutas; -T es prueba de rendimiento y queda fuera"},
  {"cmd": "ip", "sub": ["addr", "address", "a", "link", "l", "route", "r", "rule", "neigh", "n", "maddr", "tunnel"], "deny": ["^(set|add|del|delete|flush|change|replace|append|exec|save|restore)$"], "nota": "solo show"},
  {"cmd": "ifconfig", "solo_flags": ["-a"], "max_posicionales": 1, "nota": "con una interfaz como mucho solo muestra"},
  {"cmd": "route", "solo_flags": ["-n"], "max_posicionales": 0, "nota": "solo muestra"},
  {"cmd": "arp", "solo_flags": ["-a", "-n"], "max_posicionales": 0, "nota": "solo muestra"},
  {"cmd": "netstat", "nota": "solo lee"},
  {"cmd": "ping", "requiere": ["-c"], "deny": ["^-f$"], "nota": "diagnostico ligero, siempre con -c"},
  {"cmd": "traceroute", "nota": "diagnostico ligero"},
  {"cmd": "nslookup", "nota": "diagnostico ligero"}
