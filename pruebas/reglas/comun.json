  {"cmd": "grep", "nota": "solo lee"},
  {"cmd": "egrep", "nota": "solo lee"},
  {"cmd": "sort", "deny": ["^-o", "^--output"], "nota": "sin fichero de salida"},
  {"cmd": "uniq", "max_posicionales": 0, "nota": "solo como filtro"},
